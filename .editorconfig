# Conventions for contributors' editors. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,ini,lua}]
indent_size = 2

[*.sh]
indent_size = 2

# Trailing whitespace is significant in Markdown resumes only via the
# backslash hard break, which is a character rather than whitespace -- but
# leave resume sources alone regardless.
[resumes/**]
trim_trailing_whitespace = false
