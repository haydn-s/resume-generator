# Everything personal lives in one directory, so privacy does not depend on
# guessing filenames. A file called cover-letter.md or haydn_cv.pdf is covered
# here; under the old filename patterns it would not have been.
/resumes/*
!/resumes/.gitkeep
!/resumes/out/
/resumes/out/*
!/resumes/out/.gitkeep

# Build artifacts. ./build.sh regenerates all of it.
/build/

# Tooling caches.
.ruff_cache/
node_modules/
package-lock.json

# Word leaves these behind next to an open document.
~$*
